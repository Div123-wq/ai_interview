# Google Gemini API Key (Primary AI provider)
# Get it from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Models API Key (Alternative AI provider)
# Get it from: https://github.com/marketplace/models
# Leave empty to use Gemini by default
GITHUB_MODELS_KEY=your_github_models_token_here

# GitHub Model name (used when GITHUB_MODELS_KEY is set)
# Available models: gpt-4o, gpt-4o-mini, claude-3.5-sonnet, etc.
GITHUB_MODEL=gpt-4o-mini

# Secret key for JWT token signing
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production

# Database URL
DATABASE_URL=interview.db

